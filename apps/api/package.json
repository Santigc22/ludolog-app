{
  "name": "@ludoteca/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @ludoteca/contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build -w @ludoteca/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/infrastructure/database/seeds/system/run.ts",
    "db:seed:system": "tsx src/infrastructure/database/seeds/system/run.ts",
    "db:seed:development": "tsx src/infrastructure/database/seeds/development/run.ts",
    "db:test:setup": "tsx src/infrastructure/database/testing/reset-and-verify.ts"
  },
  "dependencies": {
    "@ludoteca/contracts": "0.0.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  }
}
